# ── Veritabanı ───────────────────────────────────────────────
# Lokal Docker (docker-compose.yml) için:
#   postgresql://fener:fener@localhost:5432/fener
# Neon için Neon connection string'ini yapıştır.
DATABASE_URL=

# ── MQTT (HiveMQ Cloud) ──────────────────────────────────────
# TLS/SSL zorunlu — düz 1883 desteklenmez.
MQTT_HOST=            # xxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883        # TLS
MQTT_USER=
MQTT_PASS=

# ── Oturum (giriş) ───────────────────────────────────────────
# Oturum çerezini imzalayan gizli anahtar, en az 32 karakter.
# Üret: openssl rand -base64 48
# Değiştirilirse TÜM kullanıcıların oturumu düşer.
SESSION_SECRET=

# ── Uygulama ─────────────────────────────────────────────────
# Dashboard'ın dinleyeceği SSE endpoint'i (aynı origin).
NEXT_PUBLIC_SSE_URL=/api/events

# Harita altlığı (MapLibre stil URL'si). Boşsa anahtarsız OpenFreeMap
# (liberty / fiord) kullanılır. Uydu vb. için MapTiler gibi bir sağlayıcının stil URL'si.
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_STYLE_URL_DARK=

# Google Maps (opsiyonel; yalnızca Haritalar sayfası). İkisi de doluysa harita
# Google ile açılır; boşsa ya da kota sınırı dolunca OpenStreetMap (MapLibre).
# NEXT_PUBLIC_ değerleri derlemede gömülür: değişince yeniden build / deploy.
# Anahtar HTTP referrer + yalnızca "Maps JavaScript API" ile kısıtlanmalı;
# Map ID: JavaScript / Vector, Tilt ve Rotation açık.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Uygulama içi kota sınırları (harita yüklemesi; tüm müşteriler ortak).
# Boş = günlük 250, aylık 8000. Google Cloud'daki "Map loads per day" kotasının
# ve aylık ücretsiz kotanın ALTINDA tutun. 0 = Google kapalı.
GOOGLE_MAPS_DAILY_LIMIT=
GOOGLE_MAPS_MONTHLY_LIMIT=

# Direğe yol tarifi (Google Routes + Geocoding API; opsiyonel). YALNIZCA SUNUCU
# anahtarı: NEXT_PUBLIC_ değil, ayrı bir anahtar, API kısıtlaması "Routes API" +
# "Geocoding API"; web sitesi kısıtlaması YOK (sunucudan çağrılır).
# Boşsa rota haritada çizilmez, "Google Haritalar'da aç" bağlantısı verilir.
GOOGLE_ROUTES_API_KEY=
# Uygulama içi rota sınırları (tüm müşteriler ortak). Boş = günlük 100, aylık
# 5000 (Compute Routes Essentials ücretsiz kotası 10k/ay). Google Cloud'daki
# günlük rota kotasının ALTINDA tutun. 0 = rota çizimi kapalı.
GOOGLE_ROUTES_DAILY_LIMIT=
GOOGLE_ROUTES_MONTHLY_LIMIT=
# Adres bulma (Geocoding) sınırları; aynı anahtar. Boş = günlük 100, aylık 5000
# (Geocoding Essentials ücretsiz kotası 10k/ay). Dolunca adres doğrudan Routes'a gider.
GOOGLE_GEOCODING_DAILY_LIMIT=
GOOGLE_GEOCODING_MONTHLY_LIMIT=

# Binary uplink'in JSON aynası (izleme; firmware ekibi için). all | MAC1,MAC2 |
# boş = kapalı. Meven:<MAC>/json/data|health|reject topic'lerine basar.
MQTT_JSON_MIRROR=

# Dinamik bölge aboneliği (zone_add/remove/clear/list). Boş = on: cihazların
# dinlediği bölge/alt grup topic'leri panelden yönetilir. observe → yalnızca
# zone_list (fark admin kartında), off → hiç zone komutu gönderilmez.
MQTT_ZONE_SYNC=
